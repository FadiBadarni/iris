{
  "name": "iris-cc",
  "version": "0.5.0",
  "description": "MCP server and CLI that grounds AI coding assistants in your Next.js + Tailwind design system",
  "type": "module",
  "license": "MIT",
  "author": "Fadi Badarni",
  "homepage": "https://github.com/FadiBadarni/iris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FadiBadarni/iris.git"
  },
  "bugs": {
    "url": "https://github.com/FadiBadarni/iris/issues"
  },
  "keywords": ["tailwindcss", "claude-code", "mcp", "design-tokens", "linter", "shadcn", "nextjs"],
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "iris": "./dist/cli.js",
    "iris-hook": "./dist/hook/cli.js",
    "iris-mcp": "./dist/mcp/cli.js",
    "iris-daemon": "./dist/daemon/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js"
    }
  },
  "files": ["dist", "examples", "CHANGELOG.md", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cac": "^6.7.14",
    "chokidar": "^5.0.0",
    "culori": "^4.0.2",
    "eslint": "^8.57.0",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "postcss": "^8.5.14",
    "postcss-import": "^16.1.1",
    "postcss-value-parser": "^4.2.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/culori": "^4.0.1",
    "@types/eslint": "^8",
    "@types/node": "^22.10.0",
    "@types/postcss-import": "^14.0.3",
    "tailwindcss": "^3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
