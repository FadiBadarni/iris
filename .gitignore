# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Windows: a background OS process occasionally creates a literal `%SystemDrive%`
# directory in the cwd (Caches/cversions.db etc.). Never project content.
%SystemDrive%/

# Cache
.cache/
.eslintcache
.parcel-cache/
.turbo/

# Claude Code local settings (keep .claude/ for shared config, ignore local overrides)
.claude/settings.local.json

# Octopus orchestration session artifacts (per-run prompts; results live in ~/.claude-octopus)
.octopus/

# Claude Octopus runtime state (auto-written by orchestrate.sh — not project history)
.claude-octopus/

# iris-daemon runtime artifacts (lock + spawn sentinel; per-project, never committed)
.iris/
